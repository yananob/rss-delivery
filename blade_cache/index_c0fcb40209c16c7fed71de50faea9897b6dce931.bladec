<?php $_shouldextend[1]=1; ?>

<?php $this->startSection('content'); ?>
<div class="d-flex justify-content-between align-items-center mb-3">
 <h1>RSSフィード一覧</h1>
 <a href="<?php echo \htmlentities($basePath??'', ENT_QUOTES, 'UTF-8', false); ?>/new" class="btn btn-primary">新規追加</a>
</div>

<table class="table table-striped">
 <thead>
 <tr>
 <th>
 <a href="<?php echo \htmlentities($basePath??'', ENT_QUOTES, 'UTF-8', false); ?>/?sort=name&direction=<?php echo \htmlentities($currentSort === 'name' && $currentDirection === 'asc' ? 'desc' : 'asc'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 名前
 <?php if($currentSort === 'name'): ?>
 <?php echo \htmlentities($currentDirection === 'asc' ? '▲' : '▼'??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </a>
 </th>
 <th>状態</th>
 <th>
 <a href="<?php echo \htmlentities($basePath??'', ENT_QUOTES, 'UTF-8', false); ?>/?sort=url&direction=<?php echo \htmlentities($currentSort === 'url' && $currentDirection === 'asc' ? 'desc' : 'asc'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 URL
 <?php if($currentSort === 'url'): ?>
 <?php echo \htmlentities($currentDirection === 'asc' ? '▲' : '▼'??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </a>
 </th>
 <th>
 <a href="<?php echo \htmlentities($basePath??'', ENT_QUOTES, 'UTF-8', false); ?>/?sort=notify_method&direction=<?php echo \htmlentities($currentSort === 'notify_method' && $currentDirection === 'asc' ? 'desc' : 'asc'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 通知方法
 <?php if($currentSort === 'notify_method'): ?>
 <?php echo \htmlentities($currentDirection === 'asc' ? '▲' : '▼'??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </a>
 </th>
 <th>
 <a href="<?php echo \htmlentities($basePath??'', ENT_QUOTES, 'UTF-8', false); ?>/?sort=notify_bot&direction=<?php echo \htmlentities($currentSort === 'notify_bot' && $currentDirection === 'asc' ? 'desc' : 'asc'??'', ENT_QUOTES, 'UTF-8', false); ?>">
 通知BOT
 <?php if($currentSort === 'notify_bot'): ?>
 <?php echo \htmlentities($currentDirection === 'asc' ? '▲' : '▼'??'', ENT_QUOTES, 'UTF-8', false); ?>

 <?php endif; ?>
 </a>
 </th>
 <th>最終取得日時</th>
 <th>操作</th>
 </tr>
 </thead>
 <tbody>
 <?php $__currentLoopData = $feeds; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $feed): $loop = $this->incrementLoopIndices();  ?>
 <tr>
 <td><?php echo \htmlentities($feed->getName()??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <?php if($feed->isEnabled()): ?>
 <span class="badge bg-success">有効</span>
 <?php else: ?>
 <span class="badge bg-secondary">無効</span>
 <?php endif; ?>
 </td>
 <td><a href="<?php echo \htmlentities($feed->getUrl()??'', ENT_QUOTES, 'UTF-8', false); ?>" target="_blank"><?php echo \htmlentities($feed->getUrl()??'', ENT_QUOTES, 'UTF-8', false); ?></a></td>
 <td><?php echo \htmlentities($feed->getNotifyMethod()??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($feed->getNotifyBot() ?? '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td><?php echo \htmlentities($feed->getLastUpdatedAt() ?? '-'??'', ENT_QUOTES, 'UTF-8', false); ?></td>
 <td>
 <a href="<?php echo \htmlentities($basePath??'', ENT_QUOTES, 'UTF-8', false); ?>/edit/<?php echo \htmlentities($feed->getId()??'', ENT_QUOTES, 'UTF-8', false); ?>" class="btn btn-sm btn-outline-secondary">編集</a>
 <form action="<?php echo \htmlentities($basePath??'', ENT_QUOTES, 'UTF-8', false); ?>/delete/<?php echo \htmlentities($feed->getId()??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" class="d-inline" onsubmit="return confirm('本当に削除しますか？');">
 <button type="submit" class="btn btn-sm btn-outline-danger">削除</button>
 </form>
 </td>
 </tr>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </tbody>
</table>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout'); } ?>