<?php $_shouldextend[3]=1; ?>

<?php $this->startSection('content'); ?>
<h1><?php echo \htmlentities(isset($feed) ? 'フィード編集' : 'フィード新規作成'??'', ENT_QUOTES, 'UTF-8', false); ?></h1>

<form action="<?php echo \htmlentities(isset($feed) ? $basePath . '/edit/' . $feed->getId() : $basePath . '/new'??'', ENT_QUOTES, 'UTF-8', false); ?>" method="POST" class="mt-4">
 <div class="mb-3">
 <label for="name" class="form-label">フィード名</label>
 <input type="text" class="form-control" id="name" name="name" value="<?php echo \htmlentities($feed ? $feed->getName() : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3">
 <label for="url" class="form-label">URL</label>
 <input type="url" class="form-control" id="url" name="url" value="<?php echo \htmlentities($feed ? $feed->getUrl() : ''??'', ENT_QUOTES, 'UTF-8', false); ?>" required>
 </div>
 <div class="mb-3 form-check">
 <input type="checkbox" class="form-check-input" id="enabled" name="enabled" <?php echo \htmlentities((!$feed || $feed->isEnabled()) ? 'checked' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <label class="form-check-label" for="enabled">有効</label>
 </div>
 <div class="mb-3">
 <label for="notify_method" class="form-label">通知方法</label>
 <select class="form-select" id="notify_method" name="notify_method" required>
 <option value="LINE" <?php echo \htmlentities(($feed && $feed->getNotifyMethod() == 'LINE') ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>LINE</option>
 <option value="Save" <?php echo \htmlentities(($feed && $feed->getNotifyMethod() == 'Save') ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>Save (Raindrop)</option>
 </select>
 </div>
 <div class="mb-3">
 <label for="notify_bot" class="form-label">通知BOT ID (LINEの場合のみ)</label>
 <select class="form-select" id="notify_bot" name="notify_bot">
 <option value="">(選択してください)</option>
 <?php $__currentLoopData = $lineBotIds; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $botId): $loop = $this->incrementLoopIndices();  ?>
 <option value="<?php echo \htmlentities($botId??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php echo \htmlentities(($feed && $feed->getNotifyBot() == $botId) ? 'selected' : ''??'', ENT_QUOTES, 'UTF-8', false); ?>>
 <?php echo \htmlentities($botId??'', ENT_QUOTES, 'UTF-8', false); ?>

 </option>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </select>
 </div>

 <div class="mt-4">
 <button type="submit" class="btn btn-primary"><?php echo \htmlentities(isset($feed) ? '更新' : '保存'??'', ENT_QUOTES, 'UTF-8', false); ?></button>
 <a href="<?php echo \htmlentities($basePath??'', ENT_QUOTES, 'UTF-8', false); ?>/" class="btn btn-outline-secondary">キャンセル</a>
 </div>
</form>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[3])) { echo $this->runChild('layout'); } ?>