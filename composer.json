{
    "name": "yananob/rss-delivery",
    "description": "RSSフィードをLINEやRaindropに通知するサービス",
    "license": "proprietary",
    "require": {
        "php": "~8.2.0",
        "google/cloud-functions-framework": "^1.4",
        "google/cloud-firestore": "^1.54",
        "laminas/laminas-feed": "^2.20",
        "monolog/monolog": "^3.9",
        "nesbot/carbon": "^3.3",
        "guzzlehttp/guzzle": "^7.8",
        "eftec/bladeone": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
